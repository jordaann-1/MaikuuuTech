NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server only: required for contact/inquiry submissions and pending-upload cleanup.
SUPABASE_SECRET_KEY=YOUR_SERVER_SECRET_KEY
# Create a free Cloudflare Turnstile widget. Use documented test keys locally.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=YOUR_TURNSTILE_SECRET_KEY
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONTACT_HASH_SECRET=YOUR_RANDOM_64_CHARACTER_HEX_STRING
